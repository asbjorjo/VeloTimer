{
  "realm": "velotime",
  "enabled": true,
  "displayName": "VeloTime Realm",
  "attributes": {
    "CreateDefaultClientScopes": "true"
  },
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "rememberMe": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 30,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "velotime-user",
        "description": "User role"
      },
      {
        "name": "velotime-admin",
        "description": "Administrator for all VeloTime modules"
      },
      {
        "name": "facilities-admin",
        "description": "Facilities administrator"
      },
      {
        "name": "timing-admin",
        "description": "Timing and transponder ownership administrator"
      },
      {
        "name": "statistics-admin",
        "description": "Statistics definitions administrator"
      },
      {
        "name": "velotime-users-migration",
        "description": "Import users and their timing and statistics records",
        "composite": true,
        "composites": {
          "realm": [
            "timing-admin",
            "statistics-admin"
          ],
          "client": {
            "realm-management": [
              "query-users",
              "manage-users"
            ]
          }
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "velotime.webui",
      "name": "VeloTime Web UI",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["*"],
      "webOrigins": ["*"]
    },
    {
      "clientId": "velotime.users.migration",
      "name": "VeloTime Users Migration",
      "enabled": true,
      "secret": "${USER_MIGRATION_SECRET}",
      "clientAuthenticatorType": "client-secret",
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "velotime.statistics.processor",
      "name": "VeloTime Statistics Processor",
      "enabled": true,
      "secret": "${STATISTICS_PROCESSOR_SECRET}",
      "clientAuthenticatorType": "client-secret",
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "velotime.timing.processor",
      "name": "VeloTime Timing Processor",
      "enabled": true,
      "secret": "${TIMING_PROCESSOR_SECRET}",
      "clientAuthenticatorType": "client-secret",
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "defaultDefaultClientScopes": [
    "profile",
    "email",
    "roles",
    "web-origins",
    "basic",
    "velotime"
  ],
  "defaultOptionalClientScopes": [
    "offline_access"
  ],
  "clientScopes": [
    {
      "name": "velotime",
      "description": "VeloTime API audience, subject and permission claims",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "velotime-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "${OIDC_AUDIENCE}",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clientProfiles": {
    "profiles": [
      {
        "name": "velotime-public-pkce",
        "executors": [
          {
            "executor": "pkce-enforcer",
            "configuration": {
              "auto-configure": true
            }
          }
        ]
      }
    ]
  },
  "clientPolicies": {
    "policies": [
      {
        "name": "velotime-public-pkce",
        "enabled": true,
        "conditions": [
          {
            "condition": "client-access-type",
            "configuration": {
              "type": [
                "public"
              ]
            }
          }
        ],
        "profiles": [
          "velotime-public-pkce"
        ]
      }
    ]
  },
  "users": [
    {
      "username": "testuser",
      "enabled": true,
      "firstName": "Test",
      "lastName": "User",
      "email": "test@velotime.local",
      "credentials": [
        {
          "type": "password",
          "value": "password123",
          "temporary": false
        }
      ]
    },
    {
      "username": "service-account-velotime.users.migration",
      "enabled": true,
      "serviceAccountClientId": "velotime.users.migration",
      "realmRoles": [
        "velotime-users-migration"
      ]
    }
  ]
}

<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..</DockerfileContext>
    <EnableSdkContainerDebugging>True</EnableSdkContainerDebugging>
    <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:10.0</ContainerBaseImage>
    <IsPublishable>True</IsPublishable>
    <EnableSdkContainerSupport>True</EnableSdkContainerSupport>
    <Version>2.1.0-alpha.35</Version>
    <ContainerRepository>asbjorjo/velotime-module-notifications-processor</ContainerRepository>
    <ContainerImageTag>$(Version)</ContainerImageTag>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="SlimMessageBus.Host.AzureServiceBus" />
    <PackageReference Include="SlimMessageBus.Host.Serialization.SystemTextJson" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VeloTime.Module.Notifications.Processor.Test" />
    <ProjectReference Include="..\Module.Notifications\VeloTime.Module.Notifications.csproj" />
    <ProjectReference Include="..\ServiceDefaults\VeloTime.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>

@using VeloTime.WebUI.Mud.Client

<MudNavMenu>
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">@L["Home"]</MudNavLink>

    <MudNavLink Href="statistcs/samples" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.List">@L["Samples"]</MudNavLink>

    <AuthorizeView>
        <Authorized>
            <MudNavLink Href="transponders" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Sensors">@L["MyTransponders"]</MudNavLink>
            <AuthorizeView Policy="@AdministrationPolicies.Timing" Context="timingAccess">
                <MudNavGroup Icon="@Icons.Material.Filled.Timer" Title="@L["TimingAdministration"]">
                    <MudNavLink Href="admin/timing/installations" Match="NavLinkMatch.Prefix">@L["Installations"]</MudNavLink>
                    <MudNavLink Href="admin/timing/transponders" Match="NavLinkMatch.Prefix">@L["Transponders"]</MudNavLink>
                </MudNavGroup>
            </AuthorizeView>
            <AuthorizeView Policy="@AdministrationPolicies.Facilities" Context="facilitiesAccess">
                <MudNavGroup Icon="@Icons.Material.Filled.LocationOn" Title="@L["FacilitiesAdministration"]">
                    <MudNavLink Href="admin/facilities" Match="NavLinkMatch.Prefix">@L["Facilities"]</MudNavLink>
                </MudNavGroup>
            </AuthorizeView>
            <AuthorizeView Policy="@AdministrationPolicies.Statistics" Context="statisticsAccess">
                <MudNavGroup Icon="@Icons.Material.Filled.Analytics" Title="@L["StatisticsAdministration"]">
                    <MudNavLink Href="admin/statistics/items" Match="NavLinkMatch.Prefix">@L["Items"]</MudNavLink>
                    <MudNavLink Href="admin/statistics/configurations" Match="NavLinkMatch.Prefix">@L["Configurations"]</MudNavLink>
                </MudNavGroup>
            </AuthorizeView>
        </Authorized>
        <NotAuthorized>
            <MudNavLink Href="Account/Register" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Person">@L["Register"]</MudNavLink>
        </NotAuthorized>
    </AuthorizeView>
    <MudNavGroup Icon="@Icons.Material.Filled.Info" Title="@L["About"]">
        <MudNavLink Href="about/privacy">@L["Privacy"]</MudNavLink>
        <MudNavLink Href="about/terms">@L["Terms"]</MudNavLink>
        <MudNavLink Href="about/velotime">@L["AboutVeloTime"]</MudNavLink>
    </MudNavGroup>
</MudNavMenu>

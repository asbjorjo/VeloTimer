@page "/debug/auth"

@using System.Security.Claims
@using System.Text.Json
@using VeloTime.WebUI.Mud.Client.Services
@using VeloTime.WebUI.Mud.Client.ViewModel

@inject IAuthDebugService AuthDebugService

@attribute [Authorize]

<PageTitle>Auth debug</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Auth debug</MudText>

@if (loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (error is not null)
{
    <MudAlert Severity="Severity.Error">@error</MudAlert>
}
else if (tokenInfo is null)
{
    <MudAlert Severity="Severity.Info">Auth debugging is only available in the Development environment.</MudAlert>
}
else
{
    <MudStack Spacing="4">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h5" GutterBottom="true">Access token</MudText>
            @if (!tokenInfo.HasAccessToken)
            {
                <MudAlert Severity="Severity.Warning">No access token is stored for this session. Sign in again.</MudAlert>
            }
            else
            {
                <MudText Typo="Typo.subtitle2">Audience</MudText>
                @Chips(tokenInfo.Audiences)
                <MudText Typo="Typo.subtitle2" Class="mt-2">Realm roles</MudText>
                @Chips(tokenInfo.RealmRoles)
                <MudSimpleTable Dense="true" Class="mt-2">
                    <tbody>
                        <tr><td>Issuer</td><td>@tokenInfo.Issuer</td></tr>
                        <tr><td>Authorized party</td><td>@tokenInfo.AuthorizedParty</td></tr>
                        <tr><td>Scope</td><td>@tokenInfo.Scope</td></tr>
                        <tr><td>Expires</td><td>@tokenInfo.ExpiresAt?.ToLocalTime().ToString("u")</td></tr>
                    </tbody>
                </MudSimpleTable>
            }
        </MudPaper>

        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h5" GutterBottom="true">Identity</MudText>
            <MudSimpleTable Dense="true">
                <tbody>
                    <tr><td>Name</td><td>@user?.Identity?.Name</td></tr>
                    <tr><td>Authentication type</td><td>@user?.Identity?.AuthenticationType</td></tr>
                </tbody>
            </MudSimpleTable>
            <MudText Typo="Typo.subtitle2" Class="mt-2">Realm roles (realm_access claim)</MudText>
            @Chips(identityRealmRoles)
        </MudPaper>

        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h5" GutterBottom="true">Claims</MudText>
            <MudSimpleTable Dense="true" Striped="true">
                <thead>
                    <tr><th>Type</th><th>Value</th></tr>
                </thead>
                <tbody>
                    @foreach (var claim in user?.Claims ?? [])
                    {
                        <tr>
                            <td>@claim.Type</td>
                            <td style="word-break: break-all;">@claim.Value</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudPaper>
    </MudStack>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private bool loading = true;
    private string? error;
    private AuthDebugView? tokenInfo;
    private ClaimsPrincipal? user;
    private IReadOnlyList<string> identityRealmRoles = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            user = (await AuthenticationState).User;
            identityRealmRoles = ReadRealmRoles(user);
            tokenInfo = await AuthDebugService.GetAccessTokenInfoAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException)
        {
            error = "Unable to load access token details.";
        }
        finally
        {
            loading = false;
        }
    }

    private static RenderFragment Chips(IReadOnlyList<string> values) => @<div>
        @if (values.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">None</MudText>
        }
        @foreach (var value in values)
        {
            <MudChip T="string" Size="Size.Small">@value</MudChip>
        }
    </div>;

    private static IReadOnlyList<string> ReadRealmRoles(ClaimsPrincipal principal)
    {
        var roles = new List<string>();
        foreach (var claim in principal.FindAll("realm_access"))
        {
            try
            {
                using var document = JsonDocument.Parse(claim.Value);
                if (document.RootElement.TryGetProperty("roles", out var values) && values.ValueKind == JsonValueKind.Array)
                {
                    roles.AddRange(values.EnumerateArray()
                        .Where(value => value.ValueKind == JsonValueKind.String)
                        .Select(value => value.GetString()!));
                }
            }
            catch (JsonException)
            {
            }
        }

        return roles;
    }
}

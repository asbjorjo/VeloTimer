@page "/admin/facilities/{FacilityId:guid}"
@page "/admin/facilities/{FacilityId:guid}/layouts"
@attribute [Authorize(Policy = AdministrationPolicies.Facilities)]
@using VeloTime.Module.Facilities.Interface.Data
@using VeloTime.WebUI.Mud.Client.Services
@inject IInfrastructureAdministrationService Service
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>Course Layouts</PageTitle>
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
    <MudBreadcrumbs Items="@(new List<BreadcrumbItem> { new("Facilities", "/admin/facilities"), new(_facility?.Name ?? "Facility", null, true) })" />
    <MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-4">@(_facility?.Name ?? "Facility")</MudText>
    @if (_error is not null) { <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert> }
    @if (_loading) { <MudProgressLinear Indeterminate="true" /> }
    else if (_facility is not null)
    {
        <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="mb-4">
            <MudText Typo="Typo.h6">Course layouts</MudText><MudSpacer />
            <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" Href="@($"/admin/facilities/{FacilityId}/layouts/new")">New layout</MudButton>
            <MudTooltip Text="Refresh"><MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="Load" Disabled="_busy" /></MudTooltip>
        </MudStack>
        <MudTable T="CourseLayoutDTO" Items="_layouts" Dense="true" Hover="true" Elevation="0">
            <HeaderContent><MudTh>Layout</MudTh><MudTh>Segments</MudTh><MudTh>Distance</MudTh><MudTh /></HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Layout" Style="overflow-wrap:anywhere"><MudLink Href="@($"/admin/facilities/{FacilityId}/layouts/{context.Id}")">@Label(context)</MudLink></MudTd>
                <MudTd DataLabel="Segments">@context.Segments.Count</MudTd><MudTd DataLabel="Distance">@context.Segments.Sum(segment => segment.Length) m</MudTd>
                <MudTd DataLabel="Actions"><MudTooltip Text="Delete layout"><MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" OnClick="() => Delete(context)" Disabled="_busy" /></MudTooltip></MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText>No course layouts.</MudText></NoRecordsContent>
            <PagerContent><MudTablePager /></PagerContent>
        </MudTable>
    }
</MudContainer>

@code {
    [Parameter] public Guid FacilityId { get; set; }
    private readonly CancellationTokenSource _lifetime = new();
    private FacilityDTO? _facility;
    private IReadOnlyList<CourseLayoutDTO> _layouts = [];
    private bool _loading = true, _busy;
    private string? _error;
    protected override Task OnParametersSetAsync() => Load();
    private async Task Load()
    {
        _loading = true; _error = null;
        try
        {
            _facility = (await Service.GetFacilitiesAsync(_lifetime.Token)).FirstOrDefault(facility => facility.Id == FacilityId);
            if (_facility is null) { _error = "Facility not found."; return; }
            _layouts = await Service.GetLayoutsAsync(FacilityId, _lifetime.Token);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception) { _error = "Course layouts could not be loaded. Refresh to try again."; }
        finally { _loading = false; }
    }
    private async Task Delete(CourseLayoutDTO layout)
    {
        if (await Dialogs.ShowMessageBoxAsync("Delete course layout?", "The layout and unused coursepoints will be removed. Linked timing points or statistics records block deletion.", yesText: "Delete", cancelText: "Cancel") != true) return;
        _busy = true;
        try { await Service.DeleteLayoutAsync(FacilityId, layout.Id, _lifetime.Token); Snackbar.Add("Layout deleted.", Severity.Success); await Load(); }
        catch (HttpRequestException exception) { _error = exception.Message; }
        catch (Exception) { _error = "The layout could not be deleted. Try again."; }
        finally { _busy = false; }
    }
    private static string Label(CourseLayoutDTO layout) => $"Layout {layout.Id.ToString()[..8]}: {string.Join(" / ", layout.Segments.OrderBy(segment => segment.Order).Select(segment => segment.Start.Name).Take(4))}";
    public void Dispose() { _lifetime.Cancel(); _lifetime.Dispose(); }
}
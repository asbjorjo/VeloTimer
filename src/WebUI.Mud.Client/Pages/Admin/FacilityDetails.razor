@page "/admin/facilities/{FacilityId:guid}"
@page "/admin/facilities/{FacilityId:guid}/layouts"
@attribute [Authorize(Policy = AdministrationPolicies.Facilities)]
@using VeloTime.Module.Facilities.Interface.Data
@inject IInfrastructureAdministrationService Service
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>@L["CourseLayouts"]</PageTitle>
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
    <MudBreadcrumbs Items="@(new List<BreadcrumbItem> { new(L["Facilities"].Value, "/admin/facilities"), new(_facility?.Name ?? L["Facility"].Value, null, true) })" />
    <MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-4">@(_facility?.Name ?? L["Facility"].Value)</MudText>
    @if (_error is not null) { <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert> }
    @if (_loading) { <MudProgressLinear Indeterminate="true" /> }
    else if (_facility is not null)
    {
        <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="mb-4">
            <MudText Typo="Typo.h6">@L["CourseLayouts"]</MudText><MudSpacer />
            <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" Href="@($"/admin/facilities/{FacilityId}/layouts/new")">@L["NewLayout"]</MudButton>
            <MudTooltip Text="@L["Refresh"]"><MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="Load" Disabled="_busy" /></MudTooltip>
        </MudStack>
        <MudTable T="CourseLayoutDTO" Items="_layouts" Dense="true" Hover="true" Elevation="0">
            <HeaderContent><MudTh>@L["Layout"]</MudTh><MudTh>@L["Segments"]</MudTh><MudTh>@L["Distance"]</MudTh><MudTh /></HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@L["Layout"]" Style="overflow-wrap:anywhere"><MudLink Href="@($"/admin/facilities/{FacilityId}/layouts/{context.Id}")">@Label(context)</MudLink></MudTd>
                <MudTd DataLabel="@L["Segments"]">@context.Segments.Count</MudTd><MudTd DataLabel="@L["Distance"]">@context.Segments.Sum(segment => segment.Length) m</MudTd>
                <MudTd DataLabel="@L["Actions"]"><MudTooltip Text="@L["DeleteLayoutAction"]"><MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" OnClick="() => Delete(context)" Disabled="_busy" aria-label="@L["DeleteLayoutAction"]" /></MudTooltip></MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText>@L["NoCourseLayouts"]</MudText></NoRecordsContent>
            <PagerContent><MudTablePager /></PagerContent>
        </MudTable>
    }
</MudContainer>

@code {
    [Parameter] public Guid FacilityId { get; set; }
    private readonly CancellationTokenSource _lifetime = new();
    private FacilityDTO? _facility;
    private IReadOnlyList<CourseLayoutDTO> _layouts = [];
    private bool _loading = true, _busy;
    private string? _error;
    protected override Task OnParametersSetAsync() => Load();
    private async Task Load()
    {
        _loading = true; _error = null;
        try
        {
            _facility = (await Service.GetFacilitiesAsync(_lifetime.Token)).FirstOrDefault(facility => facility.Id == FacilityId);
            if (_facility is null) { _error = L["FacilityNotFound"]; return; }
            _layouts = await Service.GetLayoutsAsync(FacilityId, _lifetime.Token);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception) { _error = L["CourseLayoutsLoadFailed"]; }
        finally { _loading = false; }
    }
    private async Task Delete(CourseLayoutDTO layout)
    {
        if (await Dialogs.ShowMessageBoxAsync(L["DeleteCourseLayout"], L["DeleteCourseLayoutConfirm"], yesText: L["Delete"], cancelText: L["Cancel"]) != true) return;
        _busy = true;
        try { await Service.DeleteLayoutAsync(FacilityId, layout.Id, _lifetime.Token); Snackbar.Add(L["LayoutDeleted"], Severity.Success); await Load(); }
        catch (HttpRequestException) { _error = L["RequestFailed"]; }
        catch (Exception) { _error = L["LayoutDeleteFailed"]; }
        finally { _busy = false; }
    }
    private string Label(CourseLayoutDTO layout) => $"{L["LayoutIdLabel", layout.Id.ToString()[..8]]}: {string.Join(" / ", layout.Segments.OrderBy(segment => segment.Order).Select(segment => segment.Start.Name).Take(4))}";
    public void Dispose() { _lifetime.Cancel(); _lifetime.Dispose(); }
}
@page "/admin/facilities"
@attribute [Authorize(Policy = AdministrationPolicies.Facilities)]
@using VeloTime.Module.Facilities.Interface.Data
@using VeloTime.WebUI.Mud.Client.Services
@inject IInfrastructureAdministrationService Service
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>Facilities Administration</PageTitle>
<NavigationLock ConfirmExternalNavigation="_editing" OnBeforeInternalNavigation="ConfirmNavigation" />
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
    <MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-4">Facilities</MudText>
    @if (_error is not null) { <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert> }
    @if (_loading) { <MudProgressLinear Indeterminate="true" /> }
    else if (_editing)
    {
        <MudForm @ref="_form">
            <MudText Typo="Typo.h6">@(_id.HasValue ? "Edit facility" : "New facility")</MudText>
            <MudTextField @bind-Value="_name" Label="Facility name" Required="true" Disabled="_busy" Class="my-4" />
            <MudStack Row="true" Spacing="3">
                <MudButton StartIcon="@Icons.Material.Filled.Save" Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="_busy">Save</MudButton>
                <MudButton OnClick="Cancel" Disabled="_busy">Cancel</MudButton>
            </MudStack>
        </MudForm>
    }
    else
    {
        <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="mb-4">
            <MudTextField @bind-Value="_search" Immediate="true" Placeholder="Search facilities" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Margin="Margin.Dense" />
            <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Variant="Variant.Filled" OnClick="() => Edit(null)">New facility</MudButton>
            <MudTooltip Text="Refresh"><MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="Load" Disabled="_busy" /></MudTooltip>
        </MudStack>
        <MudTable T="FacilityDTO" Items="@_facilities.Where(facility => facility.Name.Contains(_search, StringComparison.OrdinalIgnoreCase))" Dense="true" Hover="true" Elevation="0">
            <HeaderContent><MudTh>Name</MudTh><MudTh>Course layouts</MudTh><MudTh /></HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Name"><MudLink Href="@($"/admin/facilities/{context.Id}/layouts")">@context.Name</MudLink></MudTd>
                <MudTd DataLabel="Course layouts">@context.Layouts.Count</MudTd>
                <MudTd DataLabel="Actions">
                    <MudTooltip Text="Edit facility"><MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="() => Edit(context)" Disabled="_busy" /></MudTooltip>
                    <MudTooltip Text="Delete facility"><MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" OnClick="() => Delete(context)" Disabled="_busy" /></MudTooltip>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText>No facilities.</MudText></NoRecordsContent>
            <PagerContent><MudTablePager /></PagerContent>
        </MudTable>
    }
</MudContainer>

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private IReadOnlyList<FacilityDTO> _facilities = [];
    private MudForm? _form;
    private bool _loading = true, _busy, _editing;
    private Guid? _id;
    private string _name = "", _search = "";
    private string? _error;
    protected override Task OnInitializedAsync() => Load();
    private async Task Load()
    {
        _loading = true;
        _error = null;
        try { _facilities = await Service.GetFacilitiesAsync(_lifetime.Token); }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception) { _error = "Facilities could not be loaded. Refresh to try again."; }
        finally { _loading = false; }
    }
    private void Edit(FacilityDTO? facility) { _id = facility?.Id; _name = facility?.Name ?? ""; _editing = true; _error = null; }
    private async Task Save()
    {
        await _form!.Validate();
        if (!_form.IsValid || _busy) return;
        await Mutate(async () => { await Service.SaveFacilityAsync(_id, new(_name), _lifetime.Token); _editing = false; });
    }
    private async Task Delete(FacilityDTO facility)
    {
        if (await Dialogs.ShowMessageBoxAsync("Delete facility?", $"Permanently delete '{facility.Name}'? Linked layouts, installations, or results will block deletion.", yesText: "Delete", cancelText: "Cancel") == true)
            await Mutate(() => Service.DeleteFacilityAsync(facility.Id, _lifetime.Token));
    }
    private async Task Mutate(Func<Task> action)
    {
        _busy = true; _error = null;
        try { await action(); Snackbar.Add("Saved.", Severity.Success); await Load(); }
        catch (HttpRequestException exception) { _error = exception.Message; }
        catch (Exception) { _error = "The operation could not be completed. Please try again."; }
        finally { _busy = false; }
    }
    private async Task<bool> Discard() => !_editing || await Dialogs.ShowMessageBoxAsync("Discard changes?", "Unsaved changes will be lost.", yesText: "Discard", cancelText: "Keep editing") == true;
    private async Task Cancel() { if (await Discard()) { _editing = false; _error = null; } }
    private async Task ConfirmNavigation(LocationChangingContext context) { if (!await Discard()) context.PreventNavigation(); }
    public void Dispose() { _lifetime.Cancel(); _lifetime.Dispose(); }
}
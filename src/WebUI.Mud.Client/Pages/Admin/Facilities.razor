@page "/admin/facilities"
@attribute [Authorize(Policy = AdministrationPolicies.Facilities)]
@using VeloTime.Module.Facilities.Interface.Data
@inject IInfrastructureAdministrationService Service
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject UnsavedChangesTracker UnsavedChanges
@implements IDisposable

<PageTitle>@L["FacilitiesAdministration"]</PageTitle>
<NavigationLock ConfirmExternalNavigation="_editing" OnBeforeInternalNavigation="ConfirmNavigation" />
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
    <MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-4">@L["Facilities"]</MudText>
    @if (_error is not null) { <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert> }
    @if (_loading) { <MudProgressLinear Indeterminate="true" /> }
    else if (_editing)
    {
        <MudForm @ref="_form">
            <MudText Typo="Typo.h6">@(_id.HasValue ? L["EditFacility"] : L["NewFacility"])</MudText>
            <MudTextField @bind-Value="_name" Label="@L["FacilityName"]" Required="true" Disabled="_busy" Class="my-4" />
            <MudStack Row="true" Spacing="3">
                <MudButton StartIcon="@Icons.Material.Filled.Save" Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="_busy">@L["Save"]</MudButton>
                <MudButton OnClick="Cancel" Disabled="_busy">@L["Cancel"]</MudButton>
            </MudStack>
        </MudForm>
    }
    else
    {
        <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="mb-4">
            <MudTextField @bind-Value="_search" Immediate="true" Placeholder="@L["SearchFacilities"]" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Margin="Margin.Dense" />
            <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Variant="Variant.Filled" OnClick="() => Edit(null)">@L["NewFacility"]</MudButton>
            <MudTooltip Text="@L["Refresh"]"><MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="Load" Disabled="_busy" /></MudTooltip>
        </MudStack>
        <MudTable T="FacilityDTO" Items="@_facilities.Where(facility => facility.Name.Contains(_search, StringComparison.OrdinalIgnoreCase))" Dense="true" Hover="true" Elevation="0">
            <HeaderContent><MudTh>@L["Name"]</MudTh><MudTh>@L["CourseLayouts"]</MudTh><MudTh /></HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@L["Name"]"><MudLink Href="@($"/admin/facilities/{context.Id}/layouts")">@context.Name</MudLink></MudTd>
                <MudTd DataLabel="@L["CourseLayouts"]">@context.Layouts.Count</MudTd>
                <MudTd DataLabel="@L["Actions"]">
                    <MudTooltip Text="@L["EditFacilityAction"]"><MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="() => Edit(context)" Disabled="_busy" aria-label="@L["EditFacilityAction"]" /></MudTooltip>
                    <MudTooltip Text="@L["DeleteFacilityAction"]"><MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" OnClick="() => Delete(context)" Disabled="_busy" aria-label="@L["DeleteFacilityAction"]" /></MudTooltip>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText>@L["NoFacilities"]</MudText></NoRecordsContent>
            <PagerContent><MudTablePager /></PagerContent>
        </MudTable>
    }
</MudContainer>

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private IReadOnlyList<FacilityDTO> _facilities = [];
    private MudForm? _form;
    private bool _loading = true, _busy, _editing;
    private Guid? _id;
    private string _name = "", _search = "";
    private string? _error;
    private IDisposable? _unsavedRegistration;
    protected override Task OnInitializedAsync()
    {
        _unsavedRegistration = UnsavedChanges.Register(() => _editing);
        return Load();
    }
    private async Task Load()
    {
        _loading = true;
        _error = null;
        try { _facilities = await Service.GetFacilitiesAsync(_lifetime.Token); }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception) { _error = L["FacilitiesLoadFailed"]; }
        finally { _loading = false; }
    }
    private void Edit(FacilityDTO? facility) { _id = facility?.Id; _name = facility?.Name ?? ""; _editing = true; _error = null; }
    private async Task Save()
    {
        await _form!.ValidateAsync();
        if (!_form.IsValid || _busy) return;
        await Mutate(async () => { await Service.SaveFacilityAsync(_id, new(_name), _lifetime.Token); _editing = false; });
    }
    private async Task Delete(FacilityDTO facility)
    {
        if (await Dialogs.ShowMessageBoxAsync(L["DeleteFacilityQuestion"], L["DeleteFacilityConfirm", facility.Name], yesText: L["Delete"], cancelText: L["Cancel"]) == true)
            await Mutate(() => Service.DeleteFacilityAsync(facility.Id, _lifetime.Token));
    }
    private async Task Mutate(Func<Task> action)
    {
        _busy = true; _error = null;
        try { await action(); Snackbar.Add(L["Saved"], Severity.Success); await Load(); }
        catch (HttpRequestException) { _error = L["RequestFailed"]; }
        catch (Exception) { _error = L["OperationFailed"]; }
        finally { _busy = false; }
    }
    private async Task<bool> Discard() => !_editing || await Dialogs.ShowMessageBoxAsync(L["DiscardChanges"], L["UnsavedChangesLost"], yesText: L["Delete"], cancelText: L["KeepEditingAction"]) == true;
    private async Task Cancel() { if (await Discard()) { _editing = false; _error = null; } }
    private async Task ConfirmNavigation(LocationChangingContext context) { if (!await Discard()) context.PreventNavigation(); }
    public void Dispose() { _unsavedRegistration?.Dispose(); _lifetime.Cancel(); _lifetime.Dispose(); }
}
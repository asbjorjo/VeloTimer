@inherits PresentationComponentBase
@page "/admin/timing/installations"
@page "/admin/installations"
@attribute [Authorize(Policy = AdministrationPolicies.Timing)]
@using VeloTime.Module.Timing.Interface.Data
@inject IInfrastructureAdministrationService Service
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>@L["TimingInstallationsTitle"]</PageTitle>
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
    <MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-4">@L["TimingInstallationsTitle"]</MudText>
    @if (_error is not null) { <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert> }
    @if (_loading) { <MudProgressLinear Indeterminate="true" /> }
    else
    {
        <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="mb-4">
            <MudTextField @bind-Value="_search" Placeholder="@L["SearchInstallations"]" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Margin="Margin.Dense" />
            <MudSelect T="Guid?" @bind-Value="_facilityId" Label="@L["Facility"]" Clearable="true" Margin="Margin.Dense">
                @foreach (var facility in _facilities) { <MudSelectItem T="Guid?" Value="@((Guid?)facility.Id)">@facility.Name</MudSelectItem> }
            </MudSelect>
            <MudButton Href="/admin/timing/installations/new" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Variant="Variant.Filled">@L["NewInstallation"]</MudButton>
            <MudTooltip Text="@L["Refresh"]"><MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="Load" Disabled="_busy" /></MudTooltip>
        </MudStack>
        <MudTable T="InstallationDTO" Items="@_installations.Where(Matches)" Dense="true" Hover="true" Elevation="0">
            <HeaderContent><MudTh>@L["Agent"]</MudTh><MudTh>@L["Facility"]</MudTh><MudTh>@L["System"]</MudTh><MudTh>@L["TimingPoints"]</MudTh><MudTh>@L["LastSeen"]</MudTh><MudTh /></HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@L["Agent"]" Style="overflow-wrap:anywhere"><MudLink Href="@($"/admin/timing/installations/{context.Id}")">@context.AgentId</MudLink></MudTd>
                <MudTd DataLabel="@L["Facility"]">@FacilityName(context.FacilityId)</MudTd><MudTd DataLabel="@L["System"]">@TimingSystemName(context.TimingSystem.Name)</MudTd>
                <MudTd DataLabel="@L["TimingPoints"]">@context.TimingPoints.Count</MudTd><MudTd DataLabel="@L["LastSeen"]">@Display.Timestamp(context.LastSeen)</MudTd>
                <MudTd DataLabel="@L["Actions"]"><MudTooltip Text="@L["DeleteInstallationAction"]"><MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" OnClick="() => Delete(context)" Disabled="_busy" aria-label="@L["DeleteInstallationAction"]" /></MudTooltip></MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText>@L["NoInstallations"]</MudText></NoRecordsContent>
            <PagerContent><MudTablePager /></PagerContent>
        </MudTable>
    }
</MudContainer>

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private IReadOnlyList<InstallationDTO> _installations = [];
    private IReadOnlyList<VeloTime.Module.Facilities.Interface.Data.FacilityDTO> _facilities = [];
    private bool _loading = true, _busy;
    private string? _error;
    private string _search = "";
    private Guid? _facilityId;
    protected override Task OnInitializedAsync() => Load();
    private async Task Load()
    {
        _loading = true; _error = null;
        try { _facilities = await Service.GetFacilitiesAsync(_lifetime.Token); _installations = await Service.GetInstallationsAsync(_lifetime.Token); }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception) { _error = L["InstallationsLoadFailed"]; }
        finally { _loading = false; }
    }
    private string FacilityName(Guid id) => id == Guid.Empty ? L["Unassigned"] : _facilities.FirstOrDefault(facility => facility.Id == id)?.Name ?? L["MissingFacility"];
    private string TimingSystemName(string value) => value == "Unknown" ? L["UnknownSystem"].Value : value == "MyLaps_X2" ? "MyLaps X2" : value;
    private bool Matches(InstallationDTO installation) => (!_facilityId.HasValue || installation.FacilityId == _facilityId) &&
        $"{installation.AgentId} {installation.Description} {FacilityName(installation.FacilityId)}".Contains(_search, StringComparison.OrdinalIgnoreCase);
    private async Task Delete(InstallationDTO installation)
    {
        if (await Dialogs.ShowMessageBoxAsync(L["DeleteInstallation"], L["DeleteInstallationConfirm", installation.AgentId], yesText: L["Delete"], cancelText: L["Cancel"]) != true) return;
        _busy = true;
        try { await Service.DeleteInstallationAsync(installation.Id, _lifetime.Token); Snackbar.Add(L["InstallationDeleted"], Severity.Success); await Load(); }
        catch (HttpRequestException) { _error = L["RequestFailed"]; }
        catch (Exception) { _error = L["OperationFailed"]; }
        finally { _busy = false; }
    }
    public void Dispose() { _lifetime.Cancel(); _lifetime.Dispose(); }
}
@page "/admin/timing/installations"
@page "/admin/installations"
@attribute [Authorize(Policy = AdministrationPolicies.Timing)]
@using VeloTime.Module.Timing.Interface.Data
@using VeloTime.WebUI.Mud.Client.Services
@inject IInfrastructureAdministrationService Service
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>Timing Installations</PageTitle>
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
    <MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-4">Timing installations</MudText>
    @if (_error is not null) { <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert> }
    @if (_loading) { <MudProgressLinear Indeterminate="true" /> }
    else
    {
        <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="mb-4">
            <MudTextField @bind-Value="_search" Placeholder="Search installations" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Margin="Margin.Dense" />
            <MudSelect T="Guid?" @bind-Value="_facilityId" Label="Facility" Clearable="true" Margin="Margin.Dense">
                @foreach (var facility in _facilities) { <MudSelectItem T="Guid?" Value="@((Guid?)facility.Id)">@facility.Name</MudSelectItem> }
            </MudSelect>
            <MudButton Href="/admin/timing/installations/new" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Variant="Variant.Filled">New installation</MudButton>
            <MudTooltip Text="Refresh"><MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="Load" Disabled="_busy" /></MudTooltip>
        </MudStack>
        <MudTable T="InstallationDTO" Items="@_installations.Where(Matches)" Dense="true" Hover="true" Elevation="0">
            <HeaderContent><MudTh>Agent</MudTh><MudTh>Facility</MudTh><MudTh>System</MudTh><MudTh>Timing points</MudTh><MudTh>Last seen (UTC)</MudTh><MudTh /></HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Agent" Style="overflow-wrap:anywhere"><MudLink Href="@($"/admin/timing/installations/{context.Id}")">@context.AgentId</MudLink></MudTd>
                <MudTd DataLabel="Facility">@FacilityName(context.FacilityId)</MudTd><MudTd DataLabel="System">@context.TimingSystem.Name</MudTd>
                <MudTd DataLabel="Timing points">@context.TimingPoints.Count</MudTd><MudTd DataLabel="Last seen (UTC)">@context.LastSeen?.ToUniversalTime().ToString("yyyy-MM-dd HH:mm")</MudTd>
                <MudTd DataLabel="Actions"><MudTooltip Text="Delete installation"><MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" OnClick="() => Delete(context)" Disabled="_busy" /></MudTooltip></MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText>No installations match this view.</MudText></NoRecordsContent>
            <PagerContent><MudTablePager /></PagerContent>
        </MudTable>
    }
</MudContainer>

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private IReadOnlyList<InstallationDTO> _installations = [];
    private IReadOnlyList<VeloTime.Module.Facilities.Interface.Data.FacilityDTO> _facilities = [];
    private bool _loading = true, _busy;
    private string? _error;
    private string _search = "";
    private Guid? _facilityId;
    protected override Task OnInitializedAsync() => Load();
    private async Task Load()
    {
        _loading = true; _error = null;
        try { _facilities = await Service.GetFacilitiesAsync(_lifetime.Token); _installations = await Service.GetInstallationsAsync(_lifetime.Token); }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception) { _error = "Installations could not be loaded. Refresh to try again."; }
        finally { _loading = false; }
    }
    private string FacilityName(Guid id) => id == Guid.Empty ? "Unassigned" : _facilities.FirstOrDefault(facility => facility.Id == id)?.Name ?? "Missing facility";
    private bool Matches(InstallationDTO installation) => (!_facilityId.HasValue || installation.FacilityId == _facilityId) &&
        $"{installation.AgentId} {installation.Description} {FacilityName(installation.FacilityId)}".Contains(_search, StringComparison.OrdinalIgnoreCase);
    private async Task Delete(InstallationDTO installation)
    {
        if (await Dialogs.ShowMessageBoxAsync("Delete installation?", $"Delete '{installation.AgentId}'? Existing timing points must be removed first.", yesText: "Delete", cancelText: "Cancel") != true) return;
        _busy = true;
        try { await Service.DeleteInstallationAsync(installation.Id, _lifetime.Token); Snackbar.Add("Installation deleted.", Severity.Success); await Load(); }
        catch (HttpRequestException exception) { _error = exception.Message; }
        catch (Exception) { _error = "The installation could not be deleted. Try again."; }
        finally { _busy = false; }
    }
    public void Dispose() { _lifetime.Cancel(); _lifetime.Dispose(); }
}
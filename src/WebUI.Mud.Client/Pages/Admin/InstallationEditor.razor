@page "/admin/timing/installations/new"
@page "/admin/timing/installations/{InstallationId:guid}"
@page "/admin/installations/{InstallationId:guid}"
@attribute [Authorize(Policy = AdministrationPolicies.Timing)]
@using VeloTime.Module.Timing.Interface.Data
@using VeloTime.WebUI.Mud.Client.Services
@using CoursePoint = VeloTime.Module.Facilities.Interface.Data.CoursePointDTO
@using Facility = VeloTime.Module.Facilities.Interface.Data.FacilityDTO
@inject IInfrastructureAdministrationService Service
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Installation Editor</PageTitle>
<NavigationLock ConfirmExternalNavigation="@(_dirty || _pointEditing)" OnBeforeInternalNavigation="ConfirmNavigation" />
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
    <MudBreadcrumbs Items="@(new List<BreadcrumbItem> { new("Installations", "/admin/timing/installations"), new(_installation?.AgentId ?? "New installation", null, true) })" />
    <MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-4">@(_installation?.AgentId ?? "New installation")</MudText>
    @if (_error is not null) { <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert> }
    @if (_loading) { <MudProgressLinear Indeterminate="true" /> }
    else if (_found)
    {
        <MudForm @ref="_installationForm">
            <MudGrid>
                <MudItem xs="12" md="6"><MudTextField @bind-Value="_agentId" @bind-Value:after="MarkDirty" Label="Agent ID" Required="true" Disabled="@(_busy || _pointEditing || _installation?.LastSeen is not null)" /></MudItem>
                <MudItem xs="12" md="6"><MudSelect T="string" @bind-Value="_system" @bind-Value:after="MarkDirty" Label="Timing system" Required="true" Disabled="@(_busy || _pointEditing || _installation?.LastSeen is not null)">
                    <MudSelectItem Value="@("Unknown")">Unknown</MudSelectItem><MudSelectItem Value="@("MyLaps_X2")">MyLaps X2</MudSelectItem>
                </MudSelect></MudItem>
                <MudItem xs="12" md="6"><MudSelect T="Guid?" @bind-Value="_facilityId" @bind-Value:after="MarkDirty" Label="Facility" Clearable="true" Disabled="@(_busy || _pointEditing)">
                    @foreach (var facility in _facilities) { <MudSelectItem T="Guid?" Value="@((Guid?)facility.Id)">@facility.Name</MudSelectItem> }
                </MudSelect></MudItem>
                <MudItem xs="12" md="6"><MudTextField @bind-Value="_description" @bind-Value:after="MarkDirty" Label="Description" Disabled="@(_busy || _pointEditing)" /></MudItem>
            </MudGrid>
            <MudStack Row="true" Spacing="3" Class="my-5">
                <MudButton StartIcon="@Icons.Material.Filled.Save" Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveInstallation" Disabled="@(_busy || _pointEditing || !_dirty)">Save installation</MudButton>
                <MudButton Href="/admin/timing/installations" Disabled="_busy">Back to installations</MudButton>
            </MudStack>
        </MudForm>
        @if (_installation is not null)
        {
            <MudDivider Class="my-6" />
            <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="mb-4">
                <MudText Typo="Typo.h6">Timing points</MudText><MudSpacer />
                <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="() => EditPoint(null)" Disabled="@(_busy || _dirty || _pointEditing)">New timing point</MudButton>
            </MudStack>
            @if (_pointEditing)
            {
                <MudForm @ref="_pointForm" Class="mb-6">
                    <MudGrid>
                        <MudItem xs="12" md="4"><MudTextField @bind-Value="_pointSystemId" Label="Hardware system ID" Required="true" Disabled="_busy" /></MudItem>
                        <MudItem xs="12" md="4"><MudTextField @bind-Value="_pointDescription" Label="Description" Disabled="_busy" /></MudItem>
                        <MudItem xs="12" md="4"><MudSelect T="Guid?" @bind-Value="_coursePointId" Label="Coursepoint" Clearable="true" Disabled="_busy">
                            @foreach (var point in _coursePoints.Where(point => !point.TimingPointId.HasValue || point.TimingPointId == _pointId))
                            { <MudSelectItem T="Guid?" Value="@((Guid?)point.Id)">@point.Name</MudSelectItem> }
                        </MudSelect></MudItem>
                    </MudGrid>
                    <MudStack Row="true" Class="mt-4" Spacing="3">
                        <MudButton StartIcon="@Icons.Material.Filled.Save" Color="Color.Primary" Variant="Variant.Filled" OnClick="SavePoint" Disabled="_busy">Save timing point</MudButton>
                        <MudButton OnClick="CancelPoint" Disabled="_busy">Cancel</MudButton>
                    </MudStack>
                </MudForm>
            }
            <MudTable T="TimingPointDTO" Items="_installation.TimingPoints" Dense="true" Hover="true" Elevation="0">
                <HeaderContent><MudTh>System ID</MudTh><MudTh>Description</MudTh><MudTh>Coursepoint</MudTh><MudTh /></HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="System ID">@context.SystemId</MudTd><MudTd DataLabel="Description">@context.Description</MudTd>
                    <MudTd DataLabel="Coursepoint">@(_coursePoints.FirstOrDefault(point => point.TimingPointId == context.Id)?.Name ?? "Unlinked")</MudTd>
                    <MudTd DataLabel="Actions">
                        <MudTooltip Text="Edit timing point"><MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="() => EditPoint(context)" Disabled="@(_busy || _dirty || _pointEditing)" /></MudTooltip>
                        <MudTooltip Text="Delete timing point"><MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" OnClick="() => DeletePoint(context)" Disabled="@(_busy || _dirty || _pointEditing)" /></MudTooltip>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText>No timing points.</MudText></NoRecordsContent>
            </MudTable>
        }
    }
</MudContainer>

@code {
    [Parameter] public Guid? InstallationId { get; set; }
    private readonly CancellationTokenSource _lifetime = new();
    private IReadOnlyList<Facility> _facilities = [];
    private List<CoursePoint> _coursePoints = [];
    private InstallationDTO? _installation;
    private MudForm? _installationForm, _pointForm;
    private string _agentId = "", _system = "Unknown", _description = "", _pointSystemId = "", _pointDescription = "";
    private Guid? _facilityId, _pointId, _coursePointId, _originalCoursePointId;
    private bool _loading = true, _busy, _dirty, _pointEditing, _found;
    private string? _error;
    public override Task SetParametersAsync(ParameterView parameters)
    {
        InstallationId = parameters.TryGetValue<Guid?>(nameof(InstallationId), out var id) ? id : null;
        return base.SetParametersAsync(parameters);
    }
    protected override Task OnParametersSetAsync() => Load();
    private async Task Load()
    {
        _loading = true; _error = null; _found = false;
        try
        {
            _facilities = await Service.GetFacilitiesAsync(_lifetime.Token);
            _installation = InstallationId.HasValue ? (await Service.GetInstallationsAsync(_lifetime.Token)).FirstOrDefault(installation => installation.Id == InstallationId) : null;
            if (InstallationId.HasValue && _installation is null) { _error = "Installation not found."; return; }
            _agentId = _installation?.AgentId ?? ""; _system = _installation?.TimingSystem.Name ?? "Unknown"; _description = _installation?.Description ?? "";
            _facilityId = _installation is { FacilityId: var facilityId } && facilityId != Guid.Empty ? facilityId : null;
            _coursePoints = _facilityId.HasValue ? (await Service.GetLayoutsAsync(_facilityId.Value, _lifetime.Token)).SelectMany(layout => layout.Segments)
                .SelectMany(segment => new[] { segment.Start, segment.End }).DistinctBy(point => point.Id).ToList() : [];
            _dirty = !InstallationId.HasValue; _pointEditing = false; _found = true;
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception) { _error = "The installation could not be loaded. Return to installations and try again."; }
        finally { _loading = false; }
    }
    private void MarkDirty() => _dirty = true;
    private async Task SaveInstallation()
    {
        await _installationForm!.Validate();
        if (!_installationForm.IsValid || _busy) return;
        _busy = true; _error = null;
        try
        {
            var saved = await Service.SaveInstallationAsync(_installation?.Id, new(_facilityId, _agentId, _system, _description), _lifetime.Token);
            _dirty = false; Snackbar.Add("Installation saved.", Severity.Success);
            if (!InstallationId.HasValue) Navigation.NavigateTo($"/admin/timing/installations/{saved.Id}");
            else await Load();
        }
        catch (HttpRequestException exception) { _error = exception.Message; }
        catch (Exception) { _error = "The installation could not be saved. Please try again."; }
        finally { _busy = false; }
    }
    private void EditPoint(TimingPointDTO? point)
    {
        _pointId = point?.Id; _pointSystemId = point?.SystemId ?? ""; _pointDescription = point?.Description ?? "";
        _coursePointId = point is null ? null : _coursePoints.FirstOrDefault(coursePoint => coursePoint.TimingPointId == point.Id)?.Id;
        _originalCoursePointId = _coursePointId; _pointEditing = true; _error = null;
    }
    private async Task SavePoint()
    {
        await _pointForm!.Validate();
        if (!_pointForm.IsValid || _busy) return;
        _busy = true; _error = null; var pointSaved = false;
        try
        {
            var saved = await Service.SaveTimingPointAsync(_installation!.Id, _pointId, new(_pointSystemId, _pointDescription), _lifetime.Token);
            _pointId = saved.Id; pointSaved = true;
            if (_originalCoursePointId != _coursePointId)
            {
                if (_originalCoursePointId.HasValue) { await Service.SetTimingLinkAsync(_originalCoursePointId.Value, null, _lifetime.Token); _originalCoursePointId = null; }
                if (_coursePointId.HasValue) { await Service.SetTimingLinkAsync(_coursePointId.Value, saved.Id, _lifetime.Token); _originalCoursePointId = _coursePointId; }
            }
            _pointEditing = false; Snackbar.Add("Timing point saved.", Severity.Success); await Load();
        }
        catch (HttpRequestException exception) { _error = pointSaved ? $"Timing point saved, but its coursepoint link was not completed: {exception.Message} Save again to retry the link." : exception.Message; }
        catch (Exception) { _error = pointSaved ? "Timing point saved, but its coursepoint link could not be completed. Save again to retry." : "The timing point could not be saved. Please try again."; }
        finally { _busy = false; }
    }
    private async Task DeletePoint(TimingPointDTO point)
    {
        if (await Dialogs.ShowMessageBoxAsync("Delete timing point?", "Recorded passings or linked coursepoints will block deletion. Unlink the coursepoint first if necessary.", yesText: "Delete", cancelText: "Cancel") != true) return;
        _busy = true;
        try { await Service.DeleteTimingPointAsync(_installation!.Id, point.Id, _lifetime.Token); Snackbar.Add("Timing point deleted.", Severity.Success); await Load(); }
        catch (HttpRequestException exception) { _error = exception.Message; }
        catch (Exception) { _error = "The timing point could not be deleted. Try again."; }
        finally { _busy = false; }
    }
    private async Task CancelPoint()
    {
        if (await Dialogs.ShowMessageBoxAsync("Discard changes?", "Unsaved timing-point changes will be lost.", yesText: "Discard", cancelText: "Keep editing") == true) { _pointEditing = false; _error = null; await Load(); }
    }
    private async Task ConfirmNavigation(LocationChangingContext context)
    {
        if ((_dirty || _pointEditing) && await Dialogs.ShowMessageBoxAsync("Discard changes?", "Unsaved installation or timing-point changes will be lost.", yesText: "Discard", cancelText: "Keep editing") != true) context.PreventNavigation();
    }
    public void Dispose() { _lifetime.Cancel(); _lifetime.Dispose(); }
}
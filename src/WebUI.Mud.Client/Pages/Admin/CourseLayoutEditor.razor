@inherits PresentationComponentBase
@page "/admin/facilities/{FacilityId:guid}/layouts/new"
@page "/admin/facilities/{FacilityId:guid}/layouts/{LayoutId:guid}"
@attribute [Authorize(Policy = AdministrationPolicies.Facilities)]
@using VeloTime.Module.Facilities.Interface.Data
@inject IInfrastructureAdministrationService Service
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject UnsavedChangesTracker UnsavedChanges
@implements IDisposable

<PageTitle>@L["CourseLayoutEditor"]</PageTitle>
<NavigationLock ConfirmExternalNavigation="_dirty" OnBeforeInternalNavigation="ConfirmNavigation" />
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
    <MudBreadcrumbs Items="@(new List<BreadcrumbItem> { new(L["Facilities"].Value, "/admin/facilities"), new(_facilityName, $"/admin/facilities/{FacilityId}/layouts"), new(L["Layout"].Value, null, true) })" />
    <MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-4">@(_savedId.HasValue ? L["LayoutIdLabel", _savedId.Value.ToString()[..8]] : L["NewCourseLayout"])</MudText>
    @if (_error is not null) { <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert> }
    @if (_loading) { <MudProgressLinear Indeterminate="true" /> }
    else if (_found)
    {
        <MudForm @ref="_form">
            <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="mb-4">
                <MudText Typo="Typo.h6">@L["Coursepoints"]</MudText><MudSpacer />
                <MudButton StartIcon="@Icons.Material.Filled.AddLocationAlt" OnClick="AddPoint" Disabled="_busy">@L["NewPoint"]</MudButton>
            </MudStack>
            <MudGrid Class="mb-4">
                <MudItem xs="12" sm="9">
                    <MudSelect T="Guid?" @bind-Value="_reuseId" Label="@L["ReuseCoursepoint"]" Clearable="true" Disabled="_busy">
                        @foreach (var point in _facilityPoints.Where(point => _points.All(existing => existing.Id != point.Id)))
                        { <MudSelectItem T="Guid?" Value="@((Guid?)point.Id)">@point.Name</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="3" Class="d-flex align-center"><MudTooltip Text="@L["AddSelectedPoint"]"><MudIconButton Icon="@Icons.Material.Filled.Add" OnClick="ReusePoint" Disabled="@(_busy || !_reuseId.HasValue)" aria-label="@L["AddSelectedPoint"]" /></MudTooltip></MudItem>
            </MudGrid>
            <MudTable T="EditablePoint" Items="_points" Dense="true" Elevation="0" Class="mb-6">
                <HeaderContent><MudTh>@L["Name"]</MudTh><MudTh>@L["TimingPoint"]</MudTh><MudTh /></HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@L["Name"]"><MudTextField @bind-Value="context.Name" @bind-Value:after="MarkDirty" Required="true" RequiredError="@L["RequiredError"]" Margin="Margin.Dense" Disabled="_busy" /></MudTd>
                    <MudTd DataLabel="@L["TimingPoint"]">@CurrentCoursePointAssociation(context)</MudTd>
                    <MudTd DataLabel="@L["Actions"]"><MudTooltip Text="@L["RemoveUnusedPoint"]"><MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" OnClick="() => RemovePoint(context)" Disabled="@(_busy || _segments.Any(segment => segment.StartId == context.Id || segment.EndId == context.Id))" aria-label="@L["RemoveUnusedPoint"]" /></MudTooltip></MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText>@L["NoCoursepoints"]</MudText></NoRecordsContent>
            </MudTable>
            <MudPaper Outlined="true" Class="pa-4 mb-6">
                <MudText Typo="Typo.h6" GutterBottom="true">@L["TimingAssociationAdmin"]</MudText>
                <MudSelect T="Guid?" Value="_associationCoursePointId" ValueChanged="SelectAssociationCoursePoint" Label="@L["Coursepoint"]" Disabled="@(_busy || _dirty || _conflictPreview is not null)">
                    @foreach (var point in _facilityPoints) { <MudSelectItem T="Guid?" Value="@((Guid?)point.Id)">@point.Name</MudSelectItem> }
                </MudSelect>
                @if (_associationCoursePointId is { } selectedId)
                {
                    var selectedPoint = _facilityPoints.FirstOrDefault(point => point.Id == selectedId);
                    <MudText Class="mt-3"><strong>@L["CurrentAssociation"]:</strong> @(_currentMappingUnavailable ? L["CurrentMappingUnavailable"] : selectedPoint is null ? L["Unlinked"] : CurrentTimingPoint(selectedPoint.TimingPointId))</MudText>
                    @if (_currentMappingUnavailable) { <MudAlert Severity="Severity.Error" role="alert" Class="my-2">@L["CurrentMappingRefreshFailed"]</MudAlert> }
                    @if (_scheduleLoading) { <MudProgressLinear Indeterminate="true" Class="my-2" /> }
                    else if (_scheduleError is not null) { <MudAlert Severity="Severity.Error" role="alert" Class="my-2">@_scheduleError</MudAlert> }
                    else
                    {
                        <MudText Typo="Typo.subtitle2" Class="mt-3">@L["EffectiveAssociationHistory"]</MudText>
                        <MudTable T="ScheduleRow" Items="BuildScheduleRows()" Dense="true" Hover="true" Elevation="0">
                            <HeaderContent><MudTh>@L["EffectiveInterval"]</MudTh><MudTh>@L["TimingPoint"]</MudTh><MudTh>@L["AssociationStatus"]</MudTh></HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="@L["EffectiveInterval"]">@FormatInterval(context.ValidFromUtc, context.ValidToUtc)</MudTd>
                                <MudTd DataLabel="@L["TimingPoint"]">@(context.TimingPointId.HasValue ? CurrentTimingPoint(context.TimingPointId) : L["Unlinked"])</MudTd>
                                <MudTd DataLabel="@L["AssociationStatus"]">@ScheduleStatus(context.ValidFromUtc, context.ValidToUtc, context.IsGap)</MudTd>
                            </RowTemplate>
                            <NoRecordsContent><MudText>@L["NoAssociationHistory"]</MudText></NoRecordsContent>
                        </MudTable>
                    }
                    <MudDivider Class="my-4" />
                    <MudText Typo="Typo.subtitle1">@L["ChangeTimingAssociation"]</MudText>
                    <MudSelect T="Guid?" @bind-Value="_associationTimingPointId" @bind-Value:after="AssociationInputChanged" Label="@L["TimingPoint"]" Clearable="true" Disabled="@(_busy || _dirty || _conflictPreview is not null)">
                        @foreach (var timing in _timingPoints) { <MudSelectItem T="Guid?" Value="@((Guid?)timing.Id)">@timing.Name</MudSelectItem> }
                    </MudSelect>
                    <MudText Typo="Typo.subtitle2">@L["AssociationChangeMode"]</MudText>
                    <MudRadioGroup T="string" @bind-Value="_associationMode" @bind-Value:after="AssociationInputChanged" Disabled="@(_busy || _dirty || _conflictPreview is not null)">
                        <MudRadio T="string" Value="@("interval")">@L["ExplicitEffectiveInterval"]</MudRadio>
                        <MudRadio T="string" Value="@("immediate")">@L["LegacyImmediateChange"]</MudRadio>
                    </MudRadioGroup>
                    @if (_associationMode == "interval")
                    {
                        <MudAlert Severity="Severity.Info" Class="my-2">@L["AssociationIntervalHelp"]</MudAlert>
                        <MudCheckBox T="bool" @bind-Value="_fromUnbounded" @bind-Value:after="AssociationInputChanged" Label="@L["NoLowerBound"]" Disabled="@(_busy || _dirty || _conflictPreview is not null)" />
                        @if (!_fromUnbounded) { <ZonedInstantEditor Draft="_fromDraft" EditorSettings="_editorSettings" Label="@L["From"]" Required="false" Disabled="@(_busy || _dirty || _conflictPreview is not null)" Changed="AssociationInputChanged" /> }
                        <MudCheckBox T="bool" @bind-Value="_toUnbounded" @bind-Value:after="AssociationInputChanged" Label="@L["NoUpperBound"]" Disabled="@(_busy || _dirty || _conflictPreview is not null)" />
                        @if (!_toUnbounded) { <ZonedInstantEditor Draft="_toDraft" EditorSettings="_editorSettings" Label="@L["ToExclusive"]" Required="false" Disabled="@(_busy || _dirty || _conflictPreview is not null)" Changed="AssociationInputChanged" /> }
                        <MudAlert Severity="Severity.Info" Class="my-2">@L["BackdatedAssociationStatisticsGuidance"]</MudAlert>
                    }
                    else { <MudAlert Severity="Severity.Info" Class="my-2">@L["LegacyImmediateHelp"]</MudAlert> }
                    @if (_associationError is not null) { <MudAlert Severity="Severity.Error" role="alert" Class="my-2">@_associationError</MudAlert> }
                    @if (_conflictPreview is { } preview)
                    {
                        <MudAlert Severity="Severity.Warning" role="alert" Class="my-2">
                            <MudText Typo="Typo.subtitle2">@L["AssociationConflictNeedsConfirmation"]</MudText>
                            @foreach (var conflict in preview.Conflicts)
                            {
                                <MudText>@ConflictDescription(conflict)</MudText>
                            }
                            <MudText>@L["ConflictConfirmationRequired"]</MudText>
                        </MudAlert>
                        <MudStack Row="true" Wrap="Wrap.Wrap" Class="my-2">
                            <MudButton Color="Color.Warning" Variant="Variant.Filled" OnClick="ConfirmAssociationConflict" Disabled="_busy">@L["ConfirmExactReplacement"]</MudButton>
                            <MudButton OnClick="ClearAssociationConflict" Disabled="_busy">@L["Cancel"]</MudButton>
                        </MudStack>
                    }
                    else
                    {
                        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAssociation" Disabled="@(_busy || _dirty || !_editorSettings.IsReady)">@L["SaveAssociation"]</MudButton>
                    }
                }
            </MudPaper>
            <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="mb-4">
                <MudText Typo="Typo.h6">@L["Segments"]</MudText><MudSpacer /><MudText>@_segments.Sum(segment => segment.Length).ToString("G", _editorSettings.NumberCulture) @_editorSettings.DistanceUnit</MudText>
                <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="AddSegment" Disabled="@(_busy || _points.Count == 0)">@L["AddSegment"]</MudButton>
            </MudStack>
            <MudTable T="EditableSegment" Items="_segments" Dense="true" Elevation="0" Class="mb-6">
                <HeaderContent><MudTh>@L["Order"]</MudTh><MudTh>@L["Start"]</MudTh><MudTh>@L["End"]</MudTh><MudTh>@L["LengthInUnit", _editorSettings.DistanceUnit]</MudTh><MudTh /></HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@L["Order"]">@(_segments.IndexOf(context) + 1)</MudTd>
                    <MudTd DataLabel="@L["Start"]"><MudSelect T="Guid?" @bind-Value="context.StartId" @bind-Value:after="MarkDirty" Required="true" RequiredError="@L["RequiredError"]" Margin="Margin.Dense" Disabled="_busy">
                        @foreach (var point in _points) { <MudSelectItem T="Guid?" Value="@((Guid?)point.Id)">@point.Name</MudSelectItem> }
                    </MudSelect></MudTd>
                    <MudTd DataLabel="@L["End"]"><MudSelect T="Guid?" @bind-Value="context.EndId" @bind-Value:after="MarkDirty" Required="true" RequiredError="@L["RequiredError"]" Margin="Margin.Dense" Disabled="_busy">
                        @foreach (var point in _points) { <MudSelectItem T="Guid?" Value="@((Guid?)point.Id)">@point.Name</MudSelectItem> }
                    </MudSelect></MudTd>
                    <MudTd DataLabel="@L["LengthInUnit", _editorSettings.DistanceUnit]"><MudNumericField T="double" @bind-Value="context.Length" @bind-Value:after="MarkDirty" Min="@_editorSettings.DistanceFromMetres(0.001)" Culture="_editorSettings.NumberCulture" Required="true" RequiredError="@L["RequiredError"]" Margin="Margin.Dense" Disabled="_busy" /></MudTd>
                    <MudTd DataLabel="@L["Actions"]">
                        <MudTooltip Text="@L["MoveSegmentUp"]"><MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" OnClick="() => Move(context, -1)" Disabled="@(_busy || _segments.IndexOf(context) == 0)" aria-label="@L["MoveSegmentUp"]" /></MudTooltip>
                        <MudTooltip Text="@L["MoveSegmentDown"]"><MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" OnClick="() => Move(context, 1)" Disabled="@(_busy || _segments.IndexOf(context) == _segments.Count - 1)" aria-label="@L["MoveSegmentDown"]" /></MudTooltip>
                        <MudTooltip Text="@L["RemoveSegment"]"><MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" OnClick="() => RemoveSegment(context)" Disabled="_busy" aria-label="@L["RemoveSegment"]" /></MudTooltip>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText>@L["NoSegments"]</MudText></NoRecordsContent>
            </MudTable>
            <MudStack Row="true" Spacing="3">
                <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" OnClick="Save" Disabled="@(_busy || !_dirty)">@L["SaveLayout"]</MudButton>
                <MudButton Href="@($"/admin/facilities/{FacilityId}/layouts")" Disabled="_busy">@L["BackToLayouts"]</MudButton>
            </MudStack>
        </MudForm>
    }
</MudContainer>

@code {
    [Parameter] public Guid FacilityId { get; set; }
    [Parameter] public Guid? LayoutId { get; set; }
    private readonly CancellationTokenSource _lifetime = new();
    private IDisposable? _unsavedRegistration;
    private EffectiveDisplaySettings _editorSettings = EffectiveDisplaySettings.Unresolved;
    private List<EditablePoint> _points = [];
    private List<EditableSegment> _segments = [];
    private List<CoursePointDTO> _facilityPoints = [];
    private List<TimingChoice> _timingPoints = [];
    private MudForm? _form;
    private bool _loading = true, _busy, _dirty, _found;
    private string? _error;
    private Guid? _associationCoursePointId, _associationTimingPointId;
    private string _associationMode = "interval";
    private bool _fromUnbounded = true, _toUnbounded = true, _scheduleLoading;
    private long _scheduleRequestGeneration;
    private bool _currentMappingUnavailable;
    private readonly ZonedInstantDraft _fromDraft = new(), _toDraft = new();
    private IReadOnlyList<CoursePointTimingAssociationSnapshot> _associationSchedule = [];
    private TimingAssociationConflictPreview? _conflictPreview;
    private SetCoursePointTimingAssociationRequest? _pendingAssociationRequest;
    private string? _associationError, _scheduleError;
    private string _facilityName = "";
    private Guid? _savedId, _reuseId;
    private Guid? _loadedFacility, _loadedLayout;
    protected override void OnInitialized() => _unsavedRegistration = UnsavedChanges.Register(() => _dirty);
    private sealed class EditablePoint { public Guid Id { get; init; } = Guid.NewGuid(); public string Name { get; set; } = ""; public Guid? TimingPointId { get; set; } }
    private sealed class EditableSegment { public Guid Id { get; init; } = Guid.NewGuid(); public Guid? StartId { get; set; } public Guid? EndId { get; set; } public DistanceEditorValue Distance { get; set; } = default!; public double Length { get => Distance.Value; set => Distance.Value = value; } }
    private sealed record TimingChoice(Guid Id, string Name);
    public override Task SetParametersAsync(ParameterView parameters)
    {
        LayoutId = parameters.TryGetValue<Guid?>(nameof(LayoutId), out var id) ? id : null;
        return base.SetParametersAsync(parameters);
    }
    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFacility == FacilityId && _loadedLayout == LayoutId)
        {
            if (!_dirty && !_busy && _editorSettings != Display)
            {
                foreach (var segment in _segments) segment.Distance = new(segment.Distance.Metres, Display);
                _editorSettings = Display;
            }
            return;
        }
        InvalidateAssociationSchedule();
        _loading = true; _error = null; _found = false; _dirty = false;
        _editorSettings = Display;
        InitializeAssociationRange();
        _savedId = LayoutId;
        try
        {
            var facility = (await Service.GetFacilitiesAsync(_lifetime.Token)).FirstOrDefault(facility => facility.Id == FacilityId);
            if (facility is null) { _error = L["FacilityNotFound"]; return; }
            _facilityName = facility.Name;
            var layouts = await Service.GetLayoutsAsync(FacilityId, _lifetime.Token);
            _facilityPoints = layouts.SelectMany(layout => layout.Segments).SelectMany(segment => new[] { segment.Start, segment.End }).DistinctBy(point => point.Id).ToList();
            _timingPoints = (await Service.GetInstallationsAsync(_lifetime.Token)).Where(installation => installation.FacilityId == FacilityId)
                .SelectMany(installation => installation.TimingPoints.Select(point => new TimingChoice(point.Id, $"{installation.AgentId}: {(string.IsNullOrWhiteSpace(point.Description) ? point.SystemId : point.Description)}"))).ToList();
            var selected = LayoutId.HasValue ? layouts.FirstOrDefault(layout => layout.Id == LayoutId) : null;
            if (LayoutId.HasValue && selected is null) { _error = L["CourseLayoutNotFound"]; return; }
            _points = selected?.Segments.SelectMany(segment => new[] { segment.Start, segment.End }).DistinctBy(point => point.Id)
                .Select(point => new EditablePoint { Id = point.Id, Name = point.Name, TimingPointId = point.TimingPointId }).ToList() ?? [];
            _segments = selected?.Segments.OrderBy(segment => segment.Order).Select(segment => new EditableSegment { Id = segment.Id, StartId = segment.Start.Id, EndId = segment.End.Id, Distance = new(segment.Length, _editorSettings) }).ToList() ?? [];
            _associationCoursePointId = null;
            _associationSchedule = [];
            _conflictPreview = null;
            _currentMappingUnavailable = false;
            _found = true;
            _loadedFacility = FacilityId; _loadedLayout = LayoutId;
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception) { _error = L["LayoutLoadFailed"]; }
        finally { _loading = false; }
    }
    private void MarkDirty() => _dirty = true;
    private void InitializeAssociationRange()
    {
        _fromUnbounded = false; _toUnbounded = true;
        _fromDraft.Date = null;
        _fromDraft.Time = null;
        _fromDraft.Offset = null;
        if (!_editorSettings.IsReady) return;
        var local = _editorSettings.Local(DateTimeOffset.UtcNow);
        _fromDraft.Date = local.Date;
        _fromDraft.Time = new TimeSpan(local.Hour, local.Minute, 0);
        _fromDraft.Offset = local.Offset;
    }
    private void AddPoint() { _points.Add(new EditablePoint()); MarkDirty(); }
    private void ReusePoint()
    {
        var point = _facilityPoints.FirstOrDefault(point => point.Id == _reuseId);
        if (point is null || _points.Any(existing => existing.Id == point.Id)) return;
        _points.Add(new EditablePoint { Id = point.Id, Name = point.Name, TimingPointId = point.TimingPointId }); _reuseId = null; MarkDirty();
    }
    private void RemovePoint(EditablePoint point) { _points.Remove(point); MarkDirty(); }
    private void AddSegment() { _segments.Add(new EditableSegment { Distance = new(100, _editorSettings), StartId = _segments.LastOrDefault()?.EndId ?? _points.FirstOrDefault()?.Id }); MarkDirty(); }
    private void RemoveSegment(EditableSegment segment) { _segments.Remove(segment); MarkDirty(); }
    private void Move(EditableSegment segment, int offset)
    {
        var index = _segments.IndexOf(segment); var target = index + offset;
        if (target < 0 || target >= _segments.Count) return;
        (_segments[index], _segments[target]) = (_segments[target], _segments[index]); MarkDirty();
    }
    private async Task Save()
    {
        await _form!.ValidateAsync();
        if (!_form.IsValid || _busy) return;
        if (_segments.Any(segment => !segment.Distance.IsValid)) { _error = L["InvalidDistance", _editorSettings.Distance(0.001)]; return; }
        if (_segments.Count == 0 || _segments.Any(segment => !segment.StartId.HasValue || !segment.EndId.HasValue)) { _error = L["AddConnectedSegments"]; return; }
        var used = _segments.SelectMany(segment => new[] { segment.StartId!.Value, segment.EndId!.Value }).ToHashSet();
        if (!used.SetEquals(_points.Select(point => point.Id))) { _error = L["UseEveryCoursepoint"]; return; }
        _busy = true; _error = null;
        try
        {
            var saved = await Service.SaveLayoutAsync(FacilityId, _savedId, new(_points.Select(point => new SaveCoursePointRequest(point.Id, point.Name)).ToList(),
                _segments.Select(segment => new SaveCourseSegmentRequest(segment.Id, segment.StartId!.Value, segment.EndId!.Value, segment.Distance.Metres)).ToList()), _lifetime.Token);
            _savedId = saved.Id;
            _dirty = false; Snackbar.Add(L["LayoutSaved"], Severity.Success);
            Navigation.NavigateTo($"/admin/facilities/{FacilityId}/layouts/{saved.Id}");
        }
        catch (HttpRequestException exception) { _error = ErrorFor(exception); }
        catch (Exception) { _error = L["LayoutSaveFailed"]; }
        finally { _busy = false; }
    }
    private async Task ConfirmNavigation(LocationChangingContext context)
    {
        if (_dirty && await Dialogs.ShowMessageBoxAsync(L["DiscardChanges"], L["DiscardLayoutChanges"], yesText: L["Delete"], cancelText: L["KeepEditingAction"]) != true) context.PreventNavigation();
    }
    private string ErrorFor(HttpRequestException exception) => exception.StatusCode switch
    {
        System.Net.HttpStatusCode.Unauthorized => L["SignInRequired"].Value,
        System.Net.HttpStatusCode.Forbidden => L["NoPermission"].Value,
        System.Net.HttpStatusCode.Conflict => L["ConflictOccurred"].Value,
        System.Net.HttpStatusCode.BadRequest or System.Net.HttpStatusCode.UnprocessableEntity => L["RequestRejected"].Value,
        System.Net.HttpStatusCode.ServiceUnavailable or System.Net.HttpStatusCode.GatewayTimeout => L["ServiceUnavailable"].Value,
        _ => L["LayoutSaveFailed"].Value
    };
    private string CurrentTimingPoint(Guid? id) => id.HasValue
        ? _timingPoints.FirstOrDefault(timing => timing.Id == id.Value)?.Name ?? L["MissingItem", id.Value.ToString()]
        : L["Unlinked"].Value;
    private string AssociationScheduleError(HttpRequestException exception) => exception.StatusCode switch
    {
        System.Net.HttpStatusCode.Unauthorized => L["SignInRequired"].Value,
        System.Net.HttpStatusCode.Forbidden => L["NoPermission"].Value,
        System.Net.HttpStatusCode.ServiceUnavailable or System.Net.HttpStatusCode.GatewayTimeout => L["ServiceUnavailable"].Value,
        _ => L["AssociationScheduleLoadFailed"].Value
    };
    private string CurrentCoursePointAssociation(EditablePoint point) => _currentMappingUnavailable
        ? L["CurrentMappingUnavailable"].Value
        : CurrentTimingPoint(point.TimingPointId);
    private async Task SelectAssociationCoursePoint(Guid? id)
    {
        var generation = ++_scheduleRequestGeneration;
        _associationCoursePointId = id;
        _associationSchedule = [];
        _conflictPreview = null;
        _pendingAssociationRequest = null;
        _associationError = _scheduleError = null;
        _scheduleLoading = id.HasValue;
        if (!id.HasValue) return;
        _associationTimingPointId = _facilityPoints.FirstOrDefault(point => point.Id == id.Value)?.TimingPointId;
        try
        {
            var schedule = await Service.GetCoursePointTimingAssociationsAsync(id.Value, _lifetime.Token);
            if (IsCurrentScheduleRequest(generation, id)) _associationSchedule = schedule;
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (HttpRequestException exception)
        {
            if (IsCurrentScheduleRequest(generation, id)) _scheduleError = AssociationScheduleError(exception);
        }
        catch (Exception)
        {
            if (IsCurrentScheduleRequest(generation, id)) _scheduleError = L["AssociationScheduleLoadFailed"].Value;
        }
        finally
        {
            if (IsCurrentScheduleRequest(generation, id)) _scheduleLoading = false;
        }
    }
    private bool IsCurrentScheduleRequest(long generation, Guid? coursePointId) =>
        generation == _scheduleRequestGeneration && _associationCoursePointId == coursePointId;
    private void InvalidateAssociationSchedule()
    {
        _scheduleRequestGeneration++;
        _associationCoursePointId = null;
        _associationSchedule = [];
        _scheduleError = null;
        _scheduleLoading = false;
    }
    private void AssociationInputChanged() { _conflictPreview = null; _pendingAssociationRequest = null; _associationError = null; }
    private async Task SaveAssociation()
    {
        if (!_associationCoursePointId.HasValue || _busy) return;
        if (!TryBuildAssociationRequest(null, out var request, out var error)) { _associationError = error; return; }
        _busy = true; _associationError = null; _conflictPreview = null;
        try
        {
            if (_associationMode == "immediate")
                await Service.SetTimingLinkAsync(_associationCoursePointId.Value, _associationTimingPointId, _lifetime.Token);
            else
                await Service.SetCoursePointTimingAssociationAsync(_associationCoursePointId.Value, request!, _lifetime.Token);
            Snackbar.Add(L["AssociationSaved"], Severity.Success);
            await RefreshCurrentMappings();
            await SelectAssociationCoursePoint(_associationCoursePointId);
        }
        catch (TimingAssociationConflictException exception) { _pendingAssociationRequest = request; _conflictPreview = exception.Preview; }
        catch (HttpRequestException exception) { _associationError = ErrorFor(exception); }
        catch (Exception) { _associationError = L["AssociationSaveFailed"].Value; }
        finally { _busy = false; }
    }
    private async Task ConfirmAssociationConflict()
    {
        if (_conflictPreview is not { } preview || _pendingAssociationRequest is not { } pending || !_associationCoursePointId.HasValue || _busy) return;
        _busy = true; _associationError = null;
        try
        {
            await Service.SetCoursePointTimingAssociationAsync(_associationCoursePointId.Value,
                pending with { ConfirmationToken = preview.ConfirmationToken }, _lifetime.Token);
            _conflictPreview = null;
            Snackbar.Add(L["AssociationSaved"].Value, Severity.Success);
            await RefreshCurrentMappings();
            await SelectAssociationCoursePoint(_associationCoursePointId);
        }
        catch (TimingAssociationConflictException exception)
        {
            // A stale token produces a fresh preview. The user must confirm this new preview separately.
            _conflictPreview = exception.Preview;
        }
        catch (HttpRequestException exception) { _conflictPreview = null; _associationError = ErrorFor(exception); }
        catch (Exception) { _conflictPreview = null; _associationError = L["AssociationSaveFailed"].Value; }
        finally { _busy = false; }
    }
    private bool TryBuildAssociationRequest(string? token, out SetCoursePointTimingAssociationRequest? request, out string error)
    {
        request = null; error = "";
        DateTimeOffset? from = null, to = null;
        if (_associationMode == "interval")
        {
            try
            {
                if (!_fromUnbounded) from = _fromDraft.Resolve(_editorSettings);
                if (!_toUnbounded) to = _toDraft.Resolve(_editorSettings);
            }
            catch (PresentationValidationException exception) { error = L[exception.ResourceKey].Value; return false; }
            if (from.HasValue && to.HasValue && from.Value >= to.Value) { error = L["AssociationInvalidRange"].Value; return false; }
        }
        request = new() { TimingPointId = _associationTimingPointId, ValidFromUtc = from, ValidToUtc = to, ConfirmationToken = token };
        return true;
    }
    private void ClearAssociationConflict() { _conflictPreview = null; _associationError = null; }
    private async Task RefreshCurrentMappings()
    {
        try
        {
            var layouts = await Service.GetLayoutsAsync(FacilityId, _lifetime.Token);
            _facilityPoints = layouts.SelectMany(layout => layout.Segments)
                .SelectMany(segment => new[] { segment.Start, segment.End }).DistinctBy(point => point.Id).ToList();
            var current = _facilityPoints.ToDictionary(point => point.Id, point => point.TimingPointId);
            foreach (var point in _points)
                if (current.TryGetValue(point.Id, out var timingPointId))
                    point.TimingPointId = timingPointId;
            _currentMappingUnavailable = false;
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception) { _currentMappingUnavailable = true; }
    }
    private string FormatInterval(DateTimeOffset? from, DateTimeOffset? to) =>
        $"{(from.HasValue ? Display.Timestamp(from.Value) : L["NegativeInfinity"].Value)} — {(to.HasValue ? Display.Timestamp(to.Value) : L["PositiveInfinity"].Value)}";
    private string ScheduleStatus(DateTimeOffset? from, DateTimeOffset? to, bool gap)
    {
        if (gap) return L["UnlinkedInterval"].Value;
        var now = DateTimeOffset.UtcNow;
        if (to.HasValue && to.Value <= now) return L["HistoricalAssociation"].Value;
        if (from.HasValue && from.Value > now) return L["ScheduledAssociation"].Value;
        return L["EffectiveAssociationInterval"].Value;
    }
    private IEnumerable<ScheduleRow> BuildScheduleRows()
    {
        var items = _associationSchedule.OrderBy(item => item.ValidFromUtc ?? DateTimeOffset.MinValue).ToArray();
        if (items.Length == 0) { yield return new(null, null, null, true); yield break; }
        DateTimeOffset? cursor = null;
        var openStart = true;
        foreach (var item in items)
        {
            if (openStart && item.ValidFromUtc.HasValue)
                yield return new(null, item.ValidFromUtc, null, true);
            else if (!openStart && cursor.HasValue && item.ValidFromUtc.HasValue && cursor.Value < item.ValidFromUtc.Value)
                yield return new(cursor, item.ValidFromUtc, null, true);
            yield return new(item.ValidFromUtc, item.ValidToUtc, item.TimingPointId, false);
            cursor = item.ValidToUtc;
            openStart = false;
        }
        if (cursor.HasValue) yield return new(cursor, null, null, true);
    }
    private string ConflictDescription(TimingAssociationDestinationConflict conflict)
    {
        var point = _facilityPoints.FirstOrDefault(item => item.Id == conflict.Association.CoursePointId);
        return L["AssociationConflictWindow",
            point?.Name ?? conflict.Association.CoursePointId.ToString(),
            CurrentTimingPoint(conflict.Association.TimingPointId),
            FormatInterval(conflict.OverlapValidFromUtc, conflict.OverlapValidToUtc)].Value;
    }
    private sealed record ScheduleRow(DateTimeOffset? ValidFromUtc, DateTimeOffset? ValidToUtc, Guid? TimingPointId, bool IsGap);
    public void Dispose() { InvalidateAssociationSchedule(); _unsavedRegistration?.Dispose(); _lifetime.Cancel(); _lifetime.Dispose(); }
}
@page "/auth"

@using Microsoft.AspNetCore.Authorization

@inject IProfileService Profile

@attribute [Authorize]

<PageTitle>@L["Auth"]</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">@L["Authenticated"]</MudText>

<AuthorizeView>
    <MudText Class="mb-4">@L["Hello"] @context.User.Identity?.Name!</MudText>
    <MudText>
        @if (string.IsNullOrWhiteSpace(username))
        {
            <MudSkeleton />
        } else
        {
            @username
        }
    </MudText>
</AuthorizeView>

@code {
    private string username = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        username = await Profile.GetUsernameAsync();
    }
}

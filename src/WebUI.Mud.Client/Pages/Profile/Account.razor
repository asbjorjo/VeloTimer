@inject NavigationManager Navigation;
@inject IProfileService Profile

<MudCard>
    <MudText>@account.DisplayName</MudText>
    @if (!account.IsConnected)
    {
        <MudLink Href="@("/authentication/addprovider/" + account.ProviderName)">Link</MudLink>
    } else
    {
        <MudButton OnClick="UnLink">Unlink</MudButton>
    }
</MudCard>

    @code {
    [Parameter]
    public required LinkedAccountView account { get; set; }

    private async Task UnLink()
    {
        await Profile.DeleteLinkedAccountAsync(account.ProviderName);
    }
}
@page "/"
@using VeloTime.WebUI.Mud.Client.Components

<MudGrid Spacing="12">
    <MudItem xs="3">
        <MudText Typo="Typo.h5">Status</MudText>
        <FacilityStatus Status="@SolaStatus" />
        <FacilityStatus Status="@AskerStatus" />
    </MudItem>
    <MudItem xs="6">
        <MudText Typo="Typo.h5">Tider</MudText>
        <MudGrid>
            <MudItem xs="12">
                <PeriodLeaders />
            </MudItem>
            <MudItem xs="12">
                <PeriodLeaders />
            </MudItem>
        </MudGrid>
    </MudItem>
</MudGrid>

@code {
    private static readonly FacilityStatusViewModel SolaStatus =
        new("Sola", false, 0);

    private static readonly FacilityStatusViewModel AskerStatus =
        new("Asker", true, 18);
}

{
  "MessageBusTopology": {
    "Topics": [
      {
        "name": "velotime-agent",
        "subscriptions": [
          {
            "name": "timing",
            "requiresSession": true,
            "rules": [
              { "name": "PassingObservedV1", "sqlFilter": "MessageName = 'PassingObservedV1'" }
            ]
          },
          {
            "name": "infrastructure",
            "requiresSession": false,
            "rules": [
              { "name": "InstallationLayoutEvent", "sqlFilter": "MessageName = 'InstallationLayoutEvent'" },
              { "name": "LoopStatusEvent", "sqlFilter": "MessageName = 'LoopStatusEvent'" }
            ]
          }
        ]
      },
      {
        "name": "velotime-timing",
        "subscriptions": [
          {
            "name": "statistics",
            "requiresSession": true,
            "rules": [
              { "name": "PassingRecordedV1", "sqlFilter": "MessageName = 'PassingRecordedV1'" },
              { "name": "TransponderOwnershipChanged", "sqlFilter": "MessageName = 'TransponderOwnershipChanged'" },
              { "name": "InstallationFacilityChangedV1", "sqlFilter": "MessageName = 'InstallationFacilityChangedV1'" }
            ]
          }
        ]
      },
      {
        "name": "velotime-facilities",
        "subscriptions": [
          {
            "name": "statistics",
            "requiresSession": true,
            "rules": [
              { "name": "CourseConfigChangedV1", "sqlFilter": "MessageName = 'CourseConfigChangedV1'" }
            ]
          }
        ]
      },
      {
        "name": "velotime-notifications",
        "subscriptions": [
          {
            "name": "webui-notifications",
            "requiresSession": false,
            "rules": [
              { "name": "NotificationsRefreshRequestedV1", "sqlFilter": "MessageName = 'NotificationsRefreshRequestedV1'" }
            ]
          }
        ]
      }
    ]
  }
}

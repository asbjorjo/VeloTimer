  "components": {
    "schemas": {
      "ActiveNotificationsDTO": {
        "required": [
          "serverNowUtc",
          "asOfUtc",
          "snapshotExpiresAtUtc",
          "nextChangeAtUtc",
          "items",
          "continuationToken"
        ],
        "type": "object",
        "properties": {
          "serverNowUtc": {
            "type": "string",
            "format": "date-time"
          },
          "asOfUtc": {
            "type": "string",
            "format": "date-time"
          },
          "snapshotExpiresAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "nextChangeAtUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NotificationPresentationDTO"
            }
          },
          "continuationToken": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "additionalProperties": false
      },
      "CreateNotificationRequest": {
        "required": [
          "content",
          "severity",
          "audience",
          "startsAtUtc"
        ],
        "type": "object",
        "properties": {
          "content": {
            "$ref": "#/components/schemas/NotificationContentDTO"
          },
          "severity": {
            "$ref": "#/components/schemas/NotificationSeverity"
          },
          "audience": {
            "$ref": "#/components/schemas/NotificationAudienceDTO"
          },
          "startsAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "endsAtUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "dismissalPolicy": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/NotificationDismissalPolicyDTO"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "DismissNotificationRequest": {

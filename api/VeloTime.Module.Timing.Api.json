{
  "openapi": "3.1.1",
  "info": {
    "title": "VeloTime.Module.Timing.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/timing/installation": {
      "get": {
        "tags": [
          "Timing"
        ],
        "parameters": [
          {
            "name": "FacilityId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/InstallationDTO"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Timing"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InstallationDTO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstallationDTO"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/timing/installation/{id}": {
      "get": {
        "tags": [
          "Timing"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstallationDTO"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "put": {
        "tags": [
          "Timing"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InstallationDTO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "delete": {
        "tags": [
          "Timing"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/timing/sample": {
      "get": {
        "tags": [
          "Timing"
        ],
        "parameters": [
          {
            "name": "count",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SampleDTO"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "InstallationDTO": {
        "required": [
          "timingSystem"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "agentId": {
            "type": "string"
          },
          "timingPoints": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TimingPointDTO"
            }
          },
          "timingSystem": {
            "$ref": "#/components/schemas/TimingSystemDTO"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "SampleDTO": {
        "required": [
          "transponderId",
          "timingPointStart",
          "timingPointEnd",
          "time",
          "duration"
        ],
        "type": "object",
        "properties": {
          "transponderId": {
            "type": "string",
            "format": "uuid"
          },
          "timingPointStart": {
            "type": "string"
          },
          "timingPointEnd": {
            "type": "string"
          },
          "time": {
            "type": "string",
            "format": "date-time"
          },
          "duration": {
            "pattern": "^-?(\\d+\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$",
            "type": "string"
          }
        }
      },
      "TimingPointDTO": {
        "required": [
          "description",
          "systemId"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "description": {
            "type": "string"
          },
          "systemId": {
            "type": "string"
          }
        }
      },
      "TimingSystemDTO": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Timing"
    }
  ]
}
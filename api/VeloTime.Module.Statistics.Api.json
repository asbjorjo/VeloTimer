  "components": {
    "schemas": {
      "BestStatisticsResultDTO": {
        "required": [
          "id",
          "statisticsItemId",
          "statisticsItemName",
          "profileName",
          "facilityId",
          "duration",
          "speed"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "statisticsItemId": {
            "type": "string",
            "format": "uuid"
          },
          "statisticsItemName": {
            "type": "string"
          },
          "profileName": {
            "type": "string"
          },
          "facilityId": {
            "type": "string",
            "format": "uuid"
          },
          "duration": {
            "pattern": "^-?(\\d+\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$",
            "type": "string"
          },
          "speed": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "CreateStatsProfileRequest": {
        "required": [
          "userId",
          "profileName"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "profileName": {
            "type": "string"
          },
          "isPublic": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "DependencySummary": {
        "required": [
          "count",
          "description"
        ],
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "format": "int32"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "GetSamplesResponse": {
        "required": [
          "samples",
          "next",
          "previous",
          "isFirstPage"
        ],
        "type": "object",
        "properties": {
          "samples": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SampleDTO"
            }
          },
          "next": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "previous": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "isFirstPage": {
            "type": "boolean"
          }
        }
      },
      "OwnerProfileDTO": {
        "required": [
          "userId",
          "profileName"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "profileName": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "OwnerProfilePage": {
        "required": [
          "profiles",
          "nextOffset"
        ],
        "type": "object",
        "properties": {
          "profiles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OwnerProfileDTO"
            }
          },
          "nextOffset": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "PublicStatisticsConfigurationDTO": {
        "required": [
          "id",
          "statisticsItemId",
          "facilityId",
          "type",
          "coursePointStart",
          "coursePointStartName",
          "coursePointEnd",
          "coursePointEndName",
          "parentConfigId",

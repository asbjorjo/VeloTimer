  "components": {
    "schemas": {
      "CourseLayoutDTO": {
        "required": [
          "id",
          "facilityId"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "facilityId": {
            "type": "string",
            "format": "uuid"
          },
          "segments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SegmentDTO"
            }
          }
        }
      },
      "CoursePointDistance": {
        "required": [
          "coursePointStartId",
          "coursePointEndId",
          "distance",
          "facilityId"
        ],
        "type": "object",
        "properties": {
          "coursePointStartId": {
            "type": "string",
            "format": "uuid"
          },
          "coursePointEndId": {
            "type": "string",
            "format": "uuid"
          },
          "distance": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "facilityId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "CoursePointDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "timingPointId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          }
        }
      },
      "FacilityDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "layouts": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "SegmentDTO": {
        "required": [
          "id",
          "start",
          "end"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "order": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "start": {
            "$ref": "#/components/schemas/CoursePointDTO"
          },
          "end": {
            "$ref": "#/components/schemas/CoursePointDTO"
          },
          "length": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      }
    }

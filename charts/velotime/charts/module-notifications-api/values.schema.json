{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "existingSecret": { "type": "string" },
    "sessionAssertion": {
      "type": "object",
      "required": ["issuer", "audience", "maximumLifetimeSeconds", "clockSkewSeconds"],
      "properties": {
        "issuer": { "type": "string" },
        "audience": { "type": "string" },
        "keyId": { "type": "string", "pattern": "^$|^[A-Za-z0-9_-]{1,64}$" },
        "publicKeyPem": { "type": "string" },
        "maximumLifetimeSeconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "clockSkewSeconds": { "type": "integer", "minimum": 0, "maximum": 10 }
      }
    },
    "httpRoute": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "hostnames": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "if": {
        "properties": { "enabled": { "const": true } },
        "required": ["enabled"]
      },
      "then": {
        "required": ["hostnames"],
        "properties": { "hostnames": { "minItems": 1 } }
      }
    }
  }
}

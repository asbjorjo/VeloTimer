{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "migrationJobs",
    "messageBusTopology"
  ],
  "properties": {
    "migrationJobs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backoffLimit",
        "activeDeadlineSeconds",
        "domains"
      ],
      "properties": {
        "backoffLimit": {
          "type": "integer",
          "minimum": 0
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "domains": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "facilities": {
              "$ref": "#/definitions/domain"
            },
            "statistics": {
              "$ref": "#/definitions/domain"
            },
            "timing": {
              "$ref": "#/definitions/domain"
            },
            "profiles": {
              "$ref": "#/definitions/domain"
            },
            "notifications": {
              "$ref": "#/definitions/domain"
            }
          }
        }
      }
    },
    "messageBusTopology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "existingSecret",
        "backoffLimit",
        "activeDeadlineSeconds",
        "image",
        "topics"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "key"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string"
            }
          }
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "topics": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/messageBusTopic"
          }
        }
      }
    }
  },
  "definitions": {
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "string"
        },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "host": {
              "type": "string",
              "minLength": 1
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "user": {
              "type": "string",
              "minLength": 1
            },
            "password": {
              "type": "string"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        }
      }
    },
    "messageBusTopic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 260
        },
        "maxSizeInMegabytes": {
          "type": "integer",
          "minimum": 1
        },
        "defaultMessageTimeToLive": {
          "type": "string",
          "pattern": "^(\\d+\\.)?\\d{1,2}:\\d{2}:\\d{2}(\\.\\d+)?$"
        },
        "requiresDuplicateDetection": {
          "type": "boolean"
        },
        "subscriptions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/messageBusSubscription"
          }
        }
      }
    },
    "messageBusSubscription": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "rules"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "requiresSession": {
          "type": "boolean"
        },
        "maxDeliveryCount": {
          "type": "integer",
          "minimum": 1
        },
        "lockDuration": {
          "type": "string",
          "pattern": "^(\\d+\\.)?\\d{1,2}:\\d{2}:\\d{2}(\\.\\d+)?$"
        },
        "defaultMessageTimeToLive": {
          "type": "string",
          "pattern": "^(\\d+\\.)?\\d{1,2}:\\d{2}:\\d{2}(\\.\\d+)?$"
        },
        "deadLetteringOnMessageExpiration": {
          "type": "boolean"
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/messageBusRule"
          }
        }
      }
    },
    "messageBusRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "pattern": "^[^$]"
        },
        "sqlFilter": {
          "type": "string",
          "minLength": 1
        },
        "correlationFilter": {
          "$ref": "#/definitions/messageBusCorrelationFilter"
        },
        "sqlAction": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "sqlFilter"
          ],
          "not": {
            "required": [
              "correlationFilter"
            ]
          }
        },
        {
          "required": [
            "correlationFilter"
          ],
          "not": {
            "required": [
              "sqlFilter"
            ]
          }
        }
      ]
    },
    "messageBusCorrelationFilter": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "correlationId": {
          "type": "string"
        },
        "messageId": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "replyTo": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "sessionId": {
          "type": "string"
        },
        "replyToSessionId": {
          "type": "string"
        },
        "contentType": {
          "type": "string"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
